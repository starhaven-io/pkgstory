{
  "name": "pkgstory-crawl-trigger",
  "version": "0.1.0",
  "description": "Cloudflare Workers that schedule pkgstory crawls and dispatch monitoring.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "deploy": "WRANGLER_WRITE_LOGS=false wrangler deploy",
    "deploy:monitor": "WRANGLER_WRITE_LOGS=false wrangler deploy --config wrangler.monitor.jsonc",
    "deploy:dry": "npm run deploy -- --dry-run && npm run deploy:monitor -- --dry-run",
    "dev": "WRANGLER_WRITE_LOGS=false wrangler dev --test-scheduled",
    "dev:monitor": "WRANGLER_WRITE_LOGS=false wrangler dev --config wrangler.monitor.jsonc --test-scheduled",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^7.0.2",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "workerd": false
  }
}
