---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import Chip from '../../../components/Chip.astro';
import Contributors from '../../../components/Contributors.astro';
import Lifecycle from '../../../components/Lifecycle.astro';
import Sparkline from '../../../components/Sparkline.astro';
import StatusChip from '../../../components/StatusChip.astro';
import Version from '../../../components/Version.astro';
import {
  bottleHistory,
  BOTTLE_HISTORY_LIMIT,
  contributors,
  getDb,
  lastChecked,
  packageMeta,
  timeline,
  TIMELINE_LIMIT,
} from '../../../lib/d1.ts';
import {
  decodeRouteParam,
  displayVersion,
  isoDate,
  isKnownSource,
  sourceLabel,
  statusOf,
  todayISO,
} from '../../../lib/format.ts';

const source = decodeRouteParam(Astro.params.source ?? '');
const name = decodeRouteParam(Astro.params.name ?? '');
if (!isKnownSource(source)) {
  return Astro.rewrite('/404');
}

// ?page=N pages back through timelines longer than TIMELINE_LIMIT (offset paging
// on the idx_events_pkg_time index). Page 1 is the bare, canonical URL.
const pageParam = Astro.url.searchParams.get('page');
const page = pageParam === null ? 1 : Number.parseInt(pageParam, 10);
if (pageParam !== null && (!Number.isInteger(page) || page < 1 || String(page) !== pageParam)) {
  return Astro.rewrite('/404');
}
const bottlePageParam = Astro.url.searchParams.get('bottle-page');
const bottlePage = bottlePageParam === null ? 1 : Number.parseInt(bottlePageParam, 10);
if (
  bottlePageParam !== null &&
  (!Number.isInteger(bottlePage) || bottlePage < 1 || String(bottlePage) !== bottlePageParam)
) {
  return Astro.rewrite('/404');
}

const encodedName = encodeURIComponent(name);
const db = getDb();
const [events, meta, packageContributors, bottleEvents] = await Promise.all([
  timeline(db, source, name, TIMELINE_LIMIT, (page - 1) * TIMELINE_LIMIT),
  packageMeta(db, source, name),
  contributors(db, source, name),
  source === 'homebrew-formula'
    ? bottleHistory(db, source, name, BOTTLE_HISTORY_LIMIT, (bottlePage - 1) * BOTTLE_HISTORY_LIMIT)
    : Promise.resolve([]),
]);

// Unknown package — or a page past the end of the timeline.
if (events.length === 0) {
  return Astro.rewrite('/404');
}

const status = meta ? statusOf(meta, todayISO()) : null;
// Prefer the denormalized latest: after a downgrade events[0] is the rolled-back
// version (re-introductions keep their original introduced_at), not the shipping one.
const latestEvent = events[0]!;
const latestVersion = meta?.latestVersion ?? latestEvent.version;
const latestRevision = meta?.latestVersion ? meta.latestRevision : latestEvent.revision;
const latestShipped = displayVersion(latestVersion, latestRevision);
const totalEvents = meta?.eventCount ?? events.length;
const totalPages = Math.max(1, Math.ceil(totalEvents / TIMELINE_LIMIT));
const totalBottleEvents = meta?.bottleEventCount ?? bottleEvents.length;
const totalBottlePages = Math.max(1, Math.ceil(totalBottleEvents / BOTTLE_HISTORY_LIMIT));
if (source !== 'homebrew-formula' && bottlePageParam !== null) return Astro.rewrite('/404');
if (bottlePage > totalBottlePages) return Astro.rewrite('/404');
const rangeStart = (page - 1) * TIMELINE_LIMIT + 1;
const rangeEnd = (page - 1) * TIMELINE_LIMIT + events.length;
const bottleRangeStart = (bottlePage - 1) * BOTTLE_HISTORY_LIMIT + 1;
const bottleRangeEnd = (bottlePage - 1) * BOTTLE_HISTORY_LIMIT + bottleEvents.length;
const packageHref = (versionPage: number, bottleHistoryPage: number) => {
  const params = new URLSearchParams();
  if (versionPage > 1) params.set('page', String(versionPage));
  if (bottleHistoryPage > 1) params.set('bottle-page', String(bottleHistoryPage));
  const query = params.toString();
  return `/${source}/${encodedName}/${query ? `?${query}` : ''}`;
};
const pageHref = (p: number) => packageHref(p, bottlePage);
const bottlePageHref = (p: number) => packageHref(page, p);

// A package page only changes when that package updates; let the edge cache it.
Astro.response.headers.set('cache-control', 'public, max-age=300, s-maxage=600');

const checkedAt = await lastChecked(db);
const repo = source === 'homebrew-cask' ? 'homebrew/homebrew-cask' : 'homebrew/homebrew-core';
const feedHref = `/${source}/${encodedName}/rss.xml`;
const sourceName = sourceLabel(source);

const dates = events.map((e) => e.introducedAt).sort((a, b) => a - b);
const first = meta?.firstIntroducedAt ?? dates[0] ?? 0;
const shownFirst = dates[0] ?? 0;
const shownLatest = dates[dates.length - 1] ?? 0;

// Median interval between updates, in days.
const intervals: number[] = [];
for (let i = 1; i < dates.length; i++) intervals.push((dates[i]! - dates[i - 1]!) / 86400);
intervals.sort((a, b) => a - b);
const median = intervals.length
  ? intervals.length % 2
    ? intervals[(intervals.length - 1) / 2]!
    : (intervals[intervals.length / 2 - 1]! + intervals[intervals.length / 2]!) / 2
  : 0;
const cadence = median > 0 ? (median < 1 ? '<1d' : `${Math.round(median)}d`) : 'single';

const monthFmt = (t: number) =>
  new Date(t * 1000).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
  });
---

<Base
  title={`${name} — pkgstory`}
  description={`${name} version history (${sourceName})`}
  feedHref={feedHref}
  lastCheckedAt={checkedAt}
  canonicalPath={pageHref(page)}
>
  <p class="crumb"><a href="/">All packages</a> / {sourceName}</p>

  <section class="pkg-overview" aria-labelledby="pkg-title">
    <div>
      <div class="pkg-head">
        <h2 id="pkg-title" class="pkg-name">{name}</h2>
        <Chip source={source} />
        {status && <StatusChip code={status} />}
      </div>
      <p class="pkg-subtitle">{sourceName} timeline from Homebrew git history.</p>
      {
        meta?.removedAt == null && (
          <p class="track">
            Track <b>{name}</b> with the <a href={feedHref}>RSS feed</a>.
          </p>
        )
      }
    </div>
    <dl class="pkg-facts">
      <div class="fact">
        <dt>Current</dt>
        <dd class="fact-current" title={latestShipped}>
          <Version version={latestVersion} revision={latestRevision} />
        </dd>
      </div>
      <div class="fact">
        <dt>Versions</dt>
        <dd>{totalEvents.toLocaleString()}</dd>
      </div>
      <div class="fact">
        <dt>Since</dt>
        <dd>{first > 0 ? monthFmt(first) : 'unknown'}</dd>
      </div>
      <div class="fact">
        <dt>Cadence</dt>
        <dd>{cadence}</dd>
      </div>
      {
        source === 'homebrew-formula' && (
          <div class="fact">
            <dt>Bottle</dt>
            <dd>{meta?.latestBottled == null ? 'unknown' : meta.latestBottled ? 'bottled' : 'not bottled'}</dd>
          </div>
        )
      }
    </dl>
  </section>

  {
    meta && (
      <Lifecycle
        name={name}
        removedAt={meta.removedAt}
        removedCommit={meta.removedCommit}
        renamedTo={meta.renamedTo}
        migratedTo={meta.migratedTo}
        deprecateDate={meta.deprecateDate}
        deprecateReason={meta.deprecateReason}
        disableDate={meta.disableDate}
        disableReason={meta.disableReason}
        repo={repo}
        lastVersion={latestShipped}
      />
    )
  }

  {
    dates.length > 1 && (
      <div class="spark-panel">
        <div class="spark-head">
          <h2>Update cadence</h2>
          <p>
            {monthFmt(shownFirst)} to {monthFmt(shownLatest)}
          </p>
        </div>
        <Sparkline
          dates={dates}
          from={shownFirst}
          to={shownLatest}
          bins={Math.min(60, Math.max(12, events.length))}
          width={880}
          height={46}
          title={`${name} update history`}
        />
      </div>
    )
  }

  <Contributors contributors={packageContributors} sourceName={sourceName} />

  <section>
    <div class="section-head">
      <h2>Version timeline</h2>
      <p>
        {
          totalPages > 1
            ? `Showing ${rangeStart.toLocaleString()}–${rangeEnd.toLocaleString()} of ${totalEvents.toLocaleString()} version-changing commits`
            : `${totalEvents.toLocaleString()} version-changing commits`
        }
      </p>
    </div>
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th>Version</th>
            <th>Updated</th>
            <th>Commit</th>
            <th>Subject</th>
          </tr>
        </thead>
        <tbody>
          {
            /* Row ids anchor the RSS item links (#<version>). */
            events.map((e) => (
              <tr id={displayVersion(e.version, e.revision)}>
                <td>
                  <Version version={e.version} revision={e.revision} />
                </td>
                <td class="date">{isoDate(e.introducedAt)}</td>
                <td>
                  {e.commitSha ? (
                    <a class="commit-link" href={`https://github.com/${repo}/commit/${e.commitSha}`}>
                      {e.commitSha.slice(0, 9)}
                    </a>
                  ) : (
                    '—'
                  )}
                </td>
                <td class="subject">{e.subject}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    {
      totalPages > 1 && (
        <nav class="pager" aria-label="Timeline pages">
          {page > 1 ? <a href={pageHref(page - 1)}>&larr; Newer</a> : <span aria-hidden="true" />}
          <span class="pager-status">
            Page {page} of {totalPages.toLocaleString()}
          </span>
          {page < totalPages ? <a href={pageHref(page + 1)}>Older &rarr;</a> : <span aria-hidden="true" />}
        </nav>
      )
    }
  </section>

  {
    source === 'homebrew-formula' && totalBottleEvents > 0 && (
      <section>
        <div class="section-head">
          <h2>Bottle history</h2>
          <p>
            {totalBottlePages > 1
              ? `Showing ${bottleRangeStart.toLocaleString()}–${bottleRangeEnd.toLocaleString()} of ${totalBottleEvents.toLocaleString()} bottle changes`
              : `${totalBottleEvents.toLocaleString()} bottle changes`}
          </p>
        </div>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th>State</th>
                <th>Version</th>
                <th>Changed</th>
                <th>Commit</th>
                <th>Subject</th>
              </tr>
            </thead>
            <tbody>
              {bottleEvents.map((event) => (
                <tr>
                  <td>{event.bottled ? 'Bottled' : 'Lost'}</td>
                  <td>{event.version ? <Version version={event.version} revision={event.revision} /> : '—'}</td>
                  <td class="date">{isoDate(event.changedAt)}</td>
                  <td>
                    {event.commitSha ? (
                      <a class="commit-link" href={`https://github.com/${repo}/commit/${event.commitSha}`}>
                        {event.commitSha.slice(0, 9)}
                      </a>
                    ) : (
                      '—'
                    )}
                  </td>
                  <td class="subject">{event.subject}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {totalBottlePages > 1 && (
          <nav class="pager" aria-label="Bottle history pages">
            {bottlePage > 1 ? <a href={bottlePageHref(bottlePage - 1)}>&larr; Newer</a> : <span aria-hidden="true" />}
            <span class="pager-status">
              Page {bottlePage} of {totalBottlePages.toLocaleString()}
            </span>
            {bottlePage < totalBottlePages ? (
              <a href={bottlePageHref(bottlePage + 1)}>Older &rarr;</a>
            ) : (
              <span aria-hidden="true" />
            )}
          </nav>
        )}
      </section>
    )
  }
</Base>
